# Deployment image for AWS Lambda (container-image mode).
#
# The local/dev image is the plain `Dockerfile`, which runs Uvicorn on port 8000.
# This one uses AWS's Lambda base image instead: it ships the Runtime Interface
# Client, which polls Lambda for events and calls the handler below.
FROM public.ecr.aws/lambda/python:3.13

# LAMBDA_TASK_ROOT is /var/task — where Lambda looks for your code.
COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

COPY app ${LAMBDA_TASK_ROOT}/app

# Not a shell command like the dev image's uvicorn line — Lambda expects
# "<module path>.<function name>" and imports it directly.
CMD ["app.lambda_handler.handler"]
